# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# pnpm — lockfile is committed so CI/Vercel builds are reproducible

# Turbo
.turbo/

# Expo (inside apps/teach)
apps/teach/.expo/
apps/teach/dist/
apps/teach/web-build/
apps/teach/expo-env.d.ts

# Next.js (inside apps/website and apps/teach-web)
apps/*/.next/
apps/*/out/
apps/*/next-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo
app-example

# generated native folders
apps/teach/ios/
apps/teach/android/

# Claude Code local config
.claude/

# Secrets / local env (never commit)
supabase-token
.supabase-prod-db-password
.env*
!.env.example

# Non-app files (business / marketing / research working docs — kept on disk, out of git)
/product/
/marketing/
/project.tex
/review
/todo
/ScheduTeach-QA-Audit-Report.*
